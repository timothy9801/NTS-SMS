{
  "name": "NTS-SMS",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r requirements.txt && python manage.py makemigrations accounts && python manage.py migrate",
  "postStartCommand": "nohup python manage.py runserver 0.0.0.0:8000 > /tmp/django.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "batisteo.vscode-django"
      ]
    }
  }
}
